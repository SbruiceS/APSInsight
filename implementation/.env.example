# APSInsight Environment Configuration
# Copy to .env and fill in values. Never commit secrets.

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=change_me_in_production
DATABASE_URL=postgres://apsinsight:apsinsight@db:5432/apsinsight_development

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional services
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

# Object storage (optional)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
